# Copy to .env for server/Docker use. The desktop app stores these encrypted via the OS keychain instead.
MARKET_DATA_PROVIDER=synthetic        # synthetic | polygon | csv
POLYGON_API_KEY=
POLYGON_REALTIME=false                # true only if your plan is licensed for real-time
FRED_API_KEY=
SEC_USER_AGENT="Your Name you@example.com"
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_SANDBOX=true
PLAID_CLIENT_ID=
PLAID_SECRET=
GB_ENCRYPTION_KEY=                    # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
JWT_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=                  # python -c "from backend.app.security import hash_password;print(hash_password('...'))"
LIVE_TRADING_ENABLED=false
MAX_POSITION_VALUE=10000
MAX_POSITION_PCT=0.10
MAX_EXPOSURE_PCT=0.95
DAILY_LOSS_LIMIT=1000
MAX_ORDERS_PER_DAY=25
DATABASE_URL=postgresql://gb:gb@localhost:5432/globalblocs
REDIS_URL=redis://localhost:6379/0
